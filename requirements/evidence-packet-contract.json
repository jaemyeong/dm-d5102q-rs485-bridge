        {
          "baseNet": "TX",
          "gpio": 26
        },
        {
          "baseNet": "RX",
          "gpio": 26
        },
        {
          "baseNet": "TX",
          "gpio": 32
        }
      ],
      "autoResolutionPermitted": false
