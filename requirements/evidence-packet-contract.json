      "requiredPower": {
        "usb": "disconnected",
        "field": "disconnected",
        "bench": "disconnected"
      },
      "requiredWiring": {
        "fieldBusConnected": false
      },
      "candidateMatrix": [
        {
          "baseNet": "RX",
          "gpio": 32
