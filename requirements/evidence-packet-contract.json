        "verification",
        "bus-owner",
        "safety-approver"
      ],
      "decisions": [
        "approved",
        "rejected"
      ],
      "scopes": [
        "clean-room-boundary",
        "rx-only-observation",
        "power-off-continuity",
        "isolated-bench-power",
        "field-bus-attachment",
        "tx-prohibited-stop-conditions"
