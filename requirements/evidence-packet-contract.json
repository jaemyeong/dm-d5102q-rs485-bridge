  "capture": {
    "recordTypes": [
      "header",
      "rx",
      "trailer"
    ],
    "sources": [
      "mcu-uart",
      "logic-analyzer"
    ],
    "timebase": "monotonic-us",
    "txPolicy": "prohibited",
    "maximumRecordBytes": 256,
    "kinds": {
      "field-passive": {
        "minimumDurationMs": 1800000
      },
      "bench-loss-115200": {
        "minimumDurationMs": 3600000
      }
    },
    "requiredTrailerZeroes": [
      "txFrames",
      "busFaults"
    ]
